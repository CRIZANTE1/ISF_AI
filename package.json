    "@supabase/supabase-js": "^2.43.4",
    "caniuse-lite": "^1.0.30001753",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.0.8",
    "framer-motion": "^12.23.24",
    "html5-qrcode": "^2.3.8",
    "i18next": "^25.6.2",
