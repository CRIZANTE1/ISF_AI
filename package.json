{
  "name": "isf-ia-app",
  "private": true,
  "version": "1.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:add:android": "cap add android",
    "android:build": "npm run build && npm run cap:sync",
    "android:setup": "npm run build && npx cap add android && npm run cap:sync",
    "android:build:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk-with-java.ps1 bundleRelease",
    "android:build:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk-with-java.ps1 assembleRelease",
    "android:build:apk:signed": "powershell -ExecutionPolicy Bypass -File ./scripts/build-signed-apk-from-env.ps1",
    "android:build:release:unix": "npm run build && npm run cap:sync && cd android && ./gradlew bundleRelease",
    "android:build:apk:unix": "npm run build && npm run cap:sync && cd android && ./gradlew assembleRelease",
    "prepare:release": "node -e \"console.log('Use: npm run prepare:release:win (Windows) ou ./scripts/prepare-apk-release.sh (Linux/Mac)')\"",
    "prepare:release:win": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-apk-release.ps1",
    "copy:icons": "node copy-icons.js",
    "clean:icons": "node clean-icons.js",
    "generate:android:icons": "node generate-android-icons.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "import:baeri": "node scripts/import-baeri-extintores.mjs",
    "import:baeri:dry-run": "node scripts/import-baeri-extintores.mjs --dry-run",
    "import:baeri:execute": "node scripts/execute-baeri-batches.mjs",
    "import:baeri:camaras-abrigos": "node scripts/import-baeri-camaras-abrigos.mjs",
    "import:baeri:camaras-abrigos:dry-run": "node scripts/import-baeri-camaras-abrigos.mjs --dry-run",
    "import:baeri:camaras-abrigos:execute": "node scripts/import-baeri-camaras-abrigos.mjs && node scripts/execute-baeri-batches.mjs batch_ca_",
    "import:baeri:chuveiros": "node scripts/import-baeri-chuveiros.mjs",
    "import:baeri:chuveiros:dry-run": "node scripts/import-baeri-chuveiros.mjs --dry-run",
    "import:baeri:chuveiros:execute": "node scripts/import-baeri-chuveiros.mjs && node scripts/execute-baeri-batches.mjs batch_cl_"
  },
