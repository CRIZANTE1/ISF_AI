    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.3.3",
    "react-icons": "^5.5.0",
    "react-joyride": "^3.1.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
